# Server-side only. Never use a VITE_ prefix for secrets.
#
# Assistant providers. AI_PROVIDERS sets the order: the first one answers, the next ones take over
# when it is down or out of quota. Without it, every provider that has a key is used, in this order:
# gemini, groq, openrouter, deepseek, xai, openai, anthropic.
# Free tiers (checked in November 2026): Gemini via Google AI Studio, Groq. DeepSeek is prepaid
# (a few cents per hundred questions). xAI (Grok) has no free tier. Content sent to a free tier may
# be used by the provider to improve its models.
AI_PROVIDERS=groq,gemini,deepseek

# Several keys per provider, separated by commas: they take turns, and a key that is rejected or
# rate-limited rests while the others carry on. A single <NAME>_API_KEY also works.
GROQ_API_KEYS=
# Free on Groq: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b. Compare them with `pnpm compare:ai`.
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEYS=
DEEPSEEK_MODEL=deepseek-flash
XAI_API_KEYS=
XAI_MODEL=grok-4.7
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=claude-haiku-5-5

# Limits on the assistant (defaults shown).
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_IP_DAY=20
AI_DAILY_LIMIT=100

# Node server only (pnpm start). Vercel ignores these.
PORT=8787
HOST=127.0.0.1
# Set TRUST_PROXY=1 only behind a proxy you control: it makes X-Forwarded-For count as the visitor's address.
TRUST_PROXY=
# The public HTTPS origin. Required in production on the Node server; Vercel needs no value.
APP_ORIGIN=http://localhost:5173

# Build time: the public address, for the canonical link, share previews and the sitemap.
# On Vercel it is taken from the production domain when not set.
SITE_URL=

# Anonymous counters and the dashboard (#admin). Both are needed: without DATABASE_URL nothing is counted,
# without ADMIN_TOKEN the dashboard refuses everyone. The table is created by docs/metrics.sql.
# DATABASE_URL is a Postgres connection string (Neon). ADMIN_TOKEN is the password of the dashboard: a long random text.
DATABASE_URL=
ADMIN_TOKEN=
# Keeps the counters in memory instead (lost on restart), to try the dashboard without a database.
METRICS_MEMORY=
